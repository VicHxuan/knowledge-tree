---
/**
 * LearningPathStepper — 学习路径垂直进度条。
 * 每步三态：未开始(0) → 进行中(1) → 已完成(2)，点击左侧按钮循环切换。
 * 进度保存在浏览器 localStorage（key: kt-lp:<pathId>），仅本机可见。
 *
 * 进阶功能（V2）：
 *  - 完成度百分比进度条 + 「继续学习」入口（第一个未完成且有链接的步骤）；
 *  - 导出 / 导入进度（JSON 文件，跨设备迁移用——数据仍只存在于你自己的文件里）。
 */
interface Step {
	title: string;
	href?: string;
	note?: string;
}
interface Props {
	pathId: string;
	steps: Step[];
}
const { pathId, steps } = Astro.props;
---

<div class="lp-stepper" data-lp-id={pathId} data-lp-count={steps.length}>
	<div class="lp-legend">
		点击每一步左侧的按钮切换进度：<span class="lp-state-0">未开始</span> →
		<span class="lp-state-1">进行中</span> → <span class="lp-state-2">已完成</span>
		（进度保存在本浏览器）
	</div>
	<ol>
		{
			steps.map((s, i) => (
				<li class="lp-step" data-i={i} data-title={s.title} data-href={s.href ?? ''}>
					<button
						type="button"
						class="lp-toggle"
						data-state="0"
						title="切换学习进度"
						aria-label={`切换「${s.title}」的学习进度`}
					>
						<span class="lp-rail" aria-hidden="true" />
						<span class="lp-dot" aria-hidden="true" />
					</button>
					<div class="lp-body">
						{s.href ? (
							<a class="lp-title" href={s.href}>
								{s.title}
							</a>
						) : (
							<span class="lp-title lp-todo">
								{s.title} <span aria-hidden="true">🚧</span>
							</span>
						)}
						{s.note && <p class="lp-note">{s.note}</p>}
					</div>
				</li>
			))
		}
	</ol>
	<div class="lp-progress" role="group" aria-label="路径进度">
		<div class="lp-bar" aria-hidden="true"><span class="lp-bar-fill"></span></div>
		<p class="lp-progress-line">
			已完成 <span class="lp-done">0</span> / {steps.length} 步
			（<span class="lp-pct">0%</span>）
			<span class="lp-continue"></span>
		</p>
		<p class="lp-actions">
			<span class="lp-msg" aria-live="polite"></span>
			<button type="button" class="lp-btn" data-act="export">导出进度</button>
			<button type="button" class="lp-btn" data-act="import">导入进度</button>
			<span class="lp-reset" role="button" tabindex="0">重置进度</span>
			<input type="file" class="lp-file" accept="application/json,.json" hidden />
		</p>
	</div>
</div>

<script>
	function initStepper(root: HTMLElement) {
		const id = root.dataset.lpId;
		if (!id) return;
		const key = `kt-lp:${id}`;
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('.lp-toggle')];
		const items = [...root.querySelectorAll<HTMLElement>('.lp-step')];
		const doneEl = root.querySelector<HTMLElement>('.lp-done');
		const pctEl = root.querySelector<HTMLElement>('.lp-pct');
		const fillEl = root.querySelector<HTMLElement>('.lp-bar-fill');
		const continueEl = root.querySelector<HTMLElement>('.lp-continue');
		const msgEl = root.querySelector<HTMLElement>('.lp-msg');
		const fileEl = root.querySelector<HTMLInputElement>('.lp-file');

		const load = (): number[] => {
			try {
				const raw = localStorage.getItem(key);
				const arr = raw ? JSON.parse(raw) : [];
				return buttons.map((_, i) => (Array.isArray(arr) && typeof arr[i] === 'number' ? arr[i] : 0));
			} catch {
				return buttons.map(() => 0);
			}
		};
		const save = (state: number[]) => {
			try {
				localStorage.setItem(key, JSON.stringify(state));
			} catch {
				/* 隐私模式等存储不可用时静默降级为会话内进度 */
			}
		};
		const say = (text: string) => {
			if (msgEl) {
				msgEl.textContent = text;
				setTimeout(() => {
					if (msgEl.textContent === text) msgEl.textContent = '';
				}, 4000);
			}
		};
		const render = (state: number[]) => {
			buttons.forEach((b, i) => (b.dataset.state = String(state[i] ?? 0)));
			const done = state.filter((s) => s === 2).length;
			const total = buttons.length || 1;
			if (doneEl) doneEl.textContent = String(done);
			if (pctEl) pctEl.textContent = `${Math.round((done / total) * 100)}%`;
			if (fillEl) fillEl.style.width = `${(done / total) * 100}%`;
			if (continueEl) {
				continueEl.replaceChildren();
				if (done === buttons.length && buttons.length > 0) {
					continueEl.textContent = '🎉 全部完成';
				} else {
					// 继续学习：第一个未完成步骤（优先有链接的；都无链接则展示无链接的下一个）
					const idx = state.findIndex((s) => s !== 2);
					const withHref = state.findIndex((s, i) => s !== 2 && items[i]?.dataset.href);
					const pick = withHref >= 0 ? withHref : idx;
					if (pick >= 0 && items[pick]) {
						const href = items[pick].dataset.href;
						const title = items[pick].dataset.title ?? '';
						const label = `继续：${title} →`;
						if (href) {
							const a = document.createElement('a');
							a.href = href;
							a.textContent = label;
							a.className = 'lp-continue-link';
							continueEl.append(a);
						} else {
							continueEl.textContent = `下一步：${title}（撰写中）`;
						}
					}
				}
			}
		};

		const state = load();
		render(state);
		buttons.forEach((b, i) =>
			b.addEventListener('click', () => {
				state[i] = ((state[i] ?? 0) + 1) % 3;
				save(state);
				render(state);
			}),
		);
		root.querySelector('.lp-reset')?.addEventListener('click', () => {
			state.forEach((_, i) => (state[i] = 0));
			save(state);
			render(state);
		});

		// 导出：下载 JSON 文件（kt-lp:<id> 的内容 + 元信息，可跨设备导入）
		root.querySelector<HTMLButtonElement>('[data-act="export"]')?.addEventListener('click', () => {
			const payload = {
				format: 'kt-learning-progress',
				version: 1,
				pathId: id,
				steps: state,
				exportedAt: new Date().toISOString(),
			};
			const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			const d = new Date();
			const mm = String(d.getMonth() + 1).padStart(2, '0');
			const dd = String(d.getDate()).padStart(2, '0');
			a.href = url;
			a.download = `learning-progress-${id}-${d.getFullYear()}${mm}${dd}.json`;
			a.click();
			URL.revokeObjectURL(url);
			say('已导出进度文件。');
		});

		// 导入：读取 JSON 文件，校验格式与步骤数后覆盖本路径进度
		root.querySelector<HTMLButtonElement>('[data-act="import"]')?.addEventListener('click', () => {
			fileEl?.click();
		});
		fileEl?.addEventListener('change', () => {
			const file = fileEl.files?.[0];
			if (!file) return;
			const reader = new FileReader();
			reader.onload = () => {
				try {
					const data = JSON.parse(String(reader.result));
					const arr = Array.isArray(data.steps) ? data.steps : undefined;
					const sameId = data.pathId === undefined || data.pathId === id;
					if (!arr || !sameId || arr.length !== buttons.length) {
						say(`导入失败：${!sameId ? '路径不匹配' : '格式或步骤数不符'}。`);
						return;
					}
					const clean = buttons.map((_, i) =>
						typeof arr[i] === 'number' ? Math.max(0, Math.min(2, arr[i] | 0)) : 0,
					);
					state.splice(0, state.length, ...clean);
					save(state);
					render(state);
					say('导入成功。');
				} catch {
					say('导入失败：文件不是合法 JSON。');
				}
			};
			reader.readAsText(file);
			fileEl.value = '';
		});
	}
	document.querySelectorAll<HTMLElement>('.lp-stepper').forEach(initStepper);
</script>

<style>
	.lp-stepper {
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		padding: 1rem 1.25rem;
		margin: 1rem 0;
		background: var(--sl-color-bg-inline-code);
	}
	.lp-legend {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin-bottom: 0.75rem;
	}
	.lp-state-1 {
		color: var(--sl-color-accent);
	}
	.lp-state-2 {
		color: #22c55e;
	}
	.lp-stepper ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.lp-step {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
	}
	.lp-step + .lp-step {
		margin-top: 0.25rem;
	}
	.lp-toggle {
		position: relative;
		width: 1.75rem;
		border: 0;
		padding: 0 0 0.5rem;
		background: none;
		cursor: pointer;
		display: flex;
		justify-content: center;
		min-height: 2rem;
	}
	.lp-rail {
		position: absolute;
		top: 0;
		bottom: -0.25rem;
		width: 2px;
		background: var(--sl-color-hairline-light);
	}
	.lp-step:last-child .lp-rail {
		display: none;
	}
	.lp-dot {
		position: relative;
		width: 0.875rem;
		height: 0.875rem;
		border-radius: 999px;
		border: 2px solid var(--sl-color-gray-4);
		background: var(--sl-color-bg);
		transition: all 150ms ease;
	}
	.lp-toggle:hover .lp-dot {
		border-color: var(--sl-color-accent);
	}
	.lp-toggle[data-state='1'] .lp-dot {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.lp-toggle[data-state='2'] .lp-dot {
		border-color: #22c55e;
		background: #22c55e;
	}
	.lp-toggle[data-state='2'] .lp-dot::after {
		content: '';
		position: absolute;
		inset: 2px;
		border-radius: 999px;
		background: var(--sl-color-bg);
		-webkit-mask: url('data:image/svg+xml;base64,')
			no-repeat center;
		mask: url('data:image/svg+xml;base64,')
			no-repeat center;
	}
	.lp-body {
		padding-top: 0.125rem;
	}
	.lp-title {
		font-weight: 600;
		text-decoration: none;
	}
	a.lp-title:hover {
		color: var(--sl-color-text-accent);
	}
	.lp-todo {
		color: var(--sl-color-gray-3);
		font-weight: 500;
	}
	.lp-note {
		margin: 0.125rem 0 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.lp-toggle[data-state='1'] ~ .lp-body .lp-title,
	.lp-toggle[data-state='2'] ~ .lp-body .lp-title {
		color: var(--sl-color-text);
	}
	.lp-progress {
		margin-top: 0.875rem;
	}
	.lp-bar {
		height: 4px;
		border-radius: 999px;
		background: var(--sl-color-hairline-light);
		overflow: hidden;
	}
	.lp-bar-fill {
		display: block;
		height: 100%;
		width: 0;
		border-radius: inherit;
		background: linear-gradient(90deg, var(--sl-color-accent), #22c55e);
		transition: width 250ms ease;
	}
	.lp-progress-line {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.lp-done {
		color: #22c55e;
		font-weight: 600;
	}
	.lp-continue {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}
	.lp-continue-link {
		color: var(--sl-color-text-accent);
		text-decoration: none;
		font-weight: 500;
	}
	.lp-continue-link:hover {
		text-decoration: underline;
	}
	.lp-actions {
		margin: 0.5rem 0 0;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		flex-wrap: wrap;
		font-size: var(--sl-text-xs);
	}
	.lp-msg {
		color: var(--sl-color-gray-3);
	}
	.lp-btn {
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		padding: 0.125rem 0.625rem;
		cursor: pointer;
		transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
	}
	.lp-btn:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
	}
	.lp-reset {
		margin-left: auto;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
		cursor: pointer;
		text-decoration: underline dotted;
	}
	.lp-reset:hover {
		color: var(--sl-color-text-accent);
	}
</style>
