---
/** 学习路径按稳定步骤 ID 记录进度；文章元信息从 content-map 派生。 */
import contentMap from '../data/content-map.json';

type Step = { slug: string; id?: string; note?: string } | { id: string; title: string; href: string; note?: string };
interface Props {
	pathId: string;
	steps: Step[];
	/** 冻结的旧版数组顺序，不能随当前 steps 重排。 */
	legacyStepIds: string[];
}
const { pathId, steps: inputSteps, legacyStepIds } = Astro.props;
const bySlug = new Map(contentMap.entries.map((entry) => [entry.slug, entry]));
const steps = inputSteps.map((step) => {
	if ('slug' in step) {
		const entry = bySlug.get(step.slug);
		if (!entry) throw new Error(`LearningPathStepper: unknown article ${step.slug}`);
		return {
			id: step.id ?? step.slug,
			title: entry.title,
			href: entry.status === 'published' ? `/knowledge-tree/${entry.slug}/` : undefined,
			note: step.note,
			status: entry.status,
		};
	}
	return { ...step, status: 'published' };
});
if (new Set(steps.map((step) => step.id)).size !== steps.length || steps.some((step) => !step.id)) {
	throw new Error(`LearningPathStepper: duplicate or empty step ID in ${pathId}`);
}
if (new Set(legacyStepIds).size !== legacyStepIds.length || legacyStepIds.some((id) => !id)) {
	throw new Error(`LearningPathStepper: invalid legacyStepIds in ${pathId}`);
}
---

<div class="lp-stepper" data-lp-id={pathId} data-lp-legacy-ids={JSON.stringify(legacyStepIds)}>
	<div class="lp-legend">
		点击步骤左侧按钮切换：<span class="lp-state-0">未开始</span> →
		<span class="lp-state-1">进行中</span> → <span class="lp-state-2">已完成</span>。
		进度保存在本浏览器，可导出文件备份。
	</div>
	<ol>
		{steps.map((step) => (
			<li class="lp-step" data-step-id={step.id} data-title={step.title} data-href={step.href ?? ''} data-status={step.status}>
				<button type="button" class="lp-toggle" data-state="0" title="切换学习进度" aria-label={`「${step.title}」：未开始，标记为进行中`}>
					<span class="lp-rail" aria-hidden="true" />
					<span class="lp-dot" aria-hidden="true" />
				</button>
				<div class="lp-body">
					{step.href ? (
						<a class="lp-title" href={step.href}>{step.title}</a>
					) : (
						<span class="lp-title lp-todo">{step.title} <span class="lp-publish-state">（撰写中）</span></span>
					)}
					{step.note && <p class="lp-note">{step.note}</p>}
				</div>
			</li>
		))}
	</ol>
	<div class="lp-progress" role="group" aria-label="路径进度">
		<div class="lp-bar" aria-hidden="true"><span class="lp-bar-fill"></span></div>
		<p class="lp-progress-line">
			已完成 <span class="lp-done">0</span> / {steps.length} 步
			（<span class="lp-pct">0%</span>）
			<span class="lp-continue"></span>
		</p>
		<p class="lp-actions">
			<span class="lp-msg" aria-live="polite"></span>
			<button type="button" class="lp-btn" data-act="export">导出进度</button>
			<button type="button" class="lp-btn" data-act="import">导入进度</button>
			<button type="button" class="lp-reset">重置进度</button>
			<input type="file" class="lp-file" accept="application/json,.json" aria-label="选择学习进度文件" hidden />
		</p>
	</div>
</div>

<script>
	import { emptyProgress, importProgress, progressPayload, restoreProgress } from '../data/learning-progress.mjs';

	function initStepper(root: HTMLElement) {
		const id = root.dataset.lpId;
		if (!id) return;
		const key = `kt-lp:${id}`;
		const items = [...root.querySelectorAll<HTMLElement>('.lp-step')];
		const buttons = items.map((item) => item.querySelector<HTMLButtonElement>('.lp-toggle')!);
		const stepIds = items.map((item) => item.dataset.stepId!);
		const schema = { pathId: id, stepIds, legacyStepIds: JSON.parse(root.dataset.lpLegacyIds ?? '[]') as string[] };
		const doneEl = root.querySelector<HTMLElement>('.lp-done');
		const pctEl = root.querySelector<HTMLElement>('.lp-pct');
		const fillEl = root.querySelector<HTMLElement>('.lp-bar-fill');
		const continueEl = root.querySelector<HTMLElement>('.lp-continue');
		const msgEl = root.querySelector<HTMLElement>('.lp-msg');
		const fileEl = root.querySelector<HTMLInputElement>('.lp-file');
		const labels = ['未开始', '进行中', '已完成'];
		let stored: unknown = null;
		try { stored = JSON.parse(localStorage.getItem(key) ?? 'null'); } catch { /* 使用空进度。 */ }
		let state = restoreProgress(stored, schema);
		const save = () => {
			try { localStorage.setItem(key, JSON.stringify(progressPayload(id, state))); }
			catch { /* 存储不可用时保留当前会话内进度。 */ }
		};
		// 成功读取的旧记录立即迁移；不覆盖未知格式或未来版本的记录。
		if (Array.isArray(stored) || (stored && typeof stored === 'object' && 'format' in stored &&
			stored.format === 'kt-learning-progress' && 'pathId' in stored && stored.pathId === id &&
			'version' in stored && (stored.version === 1 || stored.version === 2))) save();

		const say = (text: string) => {
			if (msgEl) msgEl.textContent = text;
		};
		const render = () => {
			buttons.forEach((button, index) => {
				const value = state[stepIds[index]];
				button.dataset.state = String(value);
				button.setAttribute('aria-label', `「${items[index].dataset.title}」：${labels[value]}，标记为${labels[(value + 1) % 3]}`);
			});
			const done = stepIds.filter((stepId) => state[stepId] === 2).length;
			const total = stepIds.length;
			const pct = total ? Math.round(done / total * 100) : 0;
			if (doneEl) doneEl.textContent = String(done);
			if (pctEl) pctEl.textContent = `${pct}%`;
			if (fillEl) fillEl.style.width = `${pct}%`;
			if (!continueEl) return;
			continueEl.replaceChildren();
			if (done === total && total > 0) {
				continueEl.textContent = '全部完成';
				return;
			}
			const pick = items.find((item) => state[item.dataset.stepId!] !== 2 && item.dataset.href)
				?? items.find((item) => state[item.dataset.stepId!] !== 2);
			if (!pick) return;
			if (pick.dataset.href) {
				const anchor = document.createElement('a');
				anchor.href = pick.dataset.href;
				anchor.textContent = `继续：${pick.dataset.title} →`;
				anchor.className = 'lp-continue-link';
				continueEl.append(anchor);
			} else continueEl.textContent = `下一步：${pick.dataset.title}（撰写中）`;
		};
		render();
		buttons.forEach((button, index) => button.addEventListener('click', () => {
			const stepId = stepIds[index];
			state[stepId] = (state[stepId] + 1) % 3;
			save();
			render();
		}));
		root.querySelector('.lp-reset')?.addEventListener('click', () => {
			state = emptyProgress(stepIds);
			save();
			render();
			say('已重置本路径进度。');
		});
		root.querySelector('[data-act="export"]')?.addEventListener('click', () => {
			const payload = { ...progressPayload(id, state), exportedAt: new Date().toISOString() };
			const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
			const url = URL.createObjectURL(blob);
			const anchor = document.createElement('a');
			anchor.href = url;
			anchor.download = `learning-progress-${id}-${new Date().toISOString().slice(0, 10)}.json`;
			anchor.click();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
			say('已导出进度文件。');
		});
		root.querySelector('[data-act="import"]')?.addEventListener('click', () => fileEl?.click());
		fileEl?.addEventListener('change', async () => {
			const file = fileEl.files?.[0];
			if (!file) return;
			fileEl.value = '';
			try {
				const payload = JSON.parse(await file.text());
				const result = importProgress(payload, state, schema);
				state = result.state;
				save();
				render();
				say(`导入成功，更新 ${result.matched} 个匹配步骤，其余进度保留。`);
			} catch (error) {
				say(`导入失败：${error instanceof SyntaxError ? '文件不是合法 JSON' : error instanceof Error ? error.message : '无法读取文件'}。`);
			}
		});
	}
	document.querySelectorAll<HTMLElement>('.lp-stepper').forEach(initStepper);
</script>

<style>
	.lp-stepper {
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		padding: 1rem 1.25rem;
		margin: 1rem 0;
		background: var(--sl-color-bg-inline-code);
	}
	.lp-legend {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin-bottom: 0.75rem;
	}
	.lp-state-1 {
		color: var(--sl-color-accent);
	}
	.lp-state-2 {
		color: #22c55e;
	}
	.lp-stepper ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.lp-step {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
	}
	.lp-step + .lp-step {
		margin-top: 0.25rem;
	}
	.lp-toggle {
		position: relative;
		width: 2.75rem;
		flex: none;
		border: 0;
		padding: 0 0 0.5rem;
		background: none;
		cursor: pointer;
		display: flex;
		justify-content: center;
		min-height: 2.75rem;
	}
	.lp-rail {
		position: absolute;
		top: 0;
		bottom: -0.25rem;
		width: 2px;
		background: var(--sl-color-hairline-light);
	}
	.lp-step:last-child .lp-rail {
		display: none;
	}
	.lp-dot {
		position: relative;
		width: 0.875rem;
		height: 0.875rem;
		border-radius: 999px;
		border: 2px solid var(--sl-color-gray-4);
		background: var(--sl-color-bg);
		transition: all 150ms ease;
	}
	.lp-toggle:hover .lp-dot {
		border-color: var(--sl-color-accent);
	}
	.lp-toggle[data-state='1'] .lp-dot {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.lp-toggle[data-state='2'] .lp-dot {
		border-color: #22c55e;
		background: #22c55e;
	}
	.lp-toggle[data-state='2'] .lp-dot::after {
		content: '';
		position: absolute;
		inset: 2px;
		border-radius: 999px;
		background: var(--sl-color-bg);
		-webkit-mask: url('data:image/svg+xml;base64,')
			no-repeat center;
		mask: url('data:image/svg+xml;base64,')
			no-repeat center;
	}
	.lp-body {
		padding-top: 0.125rem;
	}
	.lp-title {
		font-weight: 600;
		text-decoration: none;
	}
	a.lp-title:hover {
		color: var(--sl-color-text-accent);
	}
	.lp-todo {
		color: var(--sl-color-gray-3);
		font-weight: 500;
	}
	.lp-note {
		margin: 0.125rem 0 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.lp-toggle[data-state='1'] ~ .lp-body .lp-title,
	.lp-toggle[data-state='2'] ~ .lp-body .lp-title {
		color: var(--sl-color-text);
	}
	.lp-progress {
		margin-top: 0.875rem;
	}
	.lp-bar {
		height: 4px;
		border-radius: 999px;
		background: var(--sl-color-hairline-light);
		overflow: hidden;
	}
	.lp-bar-fill {
		display: block;
		height: 100%;
		width: 0;
		border-radius: inherit;
		background: linear-gradient(90deg, var(--sl-color-accent), #22c55e);
		transition: width 250ms ease;
	}
	.lp-progress-line {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.lp-done {
		color: #22c55e;
		font-weight: 600;
	}
	.lp-continue {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}
	.lp-continue-link {
		color: var(--sl-color-text-accent);
		text-decoration: none;
		font-weight: 500;
	}
	.lp-continue-link:hover {
		text-decoration: underline;
	}
	.lp-actions {
		margin: 0.5rem 0 0;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		flex-wrap: wrap;
		font-size: var(--sl-text-xs);
	}
	.lp-msg {
		color: var(--sl-color-gray-3);
	}
	.lp-btn {
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		padding: 0.125rem 0.625rem;
		cursor: pointer;
		transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
	}
	.lp-btn:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
	}
	.lp-reset {
		margin-left: auto;
		border: 0;
		background: none;
		padding: 0.375rem;
		min-height: 2.75rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
		cursor: pointer;
		text-decoration: underline dotted;
	}
	.lp-reset:hover {
		color: var(--sl-color-text-accent);
	}
</style>
