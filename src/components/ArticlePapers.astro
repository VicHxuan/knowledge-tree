---
import relations from '../data/paper-relations.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const slug = path.startsWith(base + '/') ? path.slice(base.length + 1).replace(/\/$/, '') : '';
const count = relations.edges.filter(e => e.article === slug).length;
---
{count > 0 && <aside class="kt-article-papers" aria-label="关联论文">
  <a href={`${base}/papers/?article=${encodeURIComponent(slug)}`}>查看本文关联的 {count} 篇论文</a>
</aside>}
<style>
  .kt-article-papers { margin: 1.5rem 0; padding: .8rem 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; font-size: .9rem; }
</style>
